# Secrets, databases and logs stay out everywhere (any folder depth).
dafnote.db
dafnote.db.*
dafnote.key
*.bak
*.bak-*
dafnote.db.bak*
server-*.log
audit.log
audit-*.log
__pycache__/

# TLS material (private CA + server keys) and DB snapshots — never commit.
certs/
dbbackup/

# Local safety snapshots (revert points).
.revert/
